# Copy to backend/.env for local development. Never commit the real file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Required in production — the app refuses to start without it, because a
# rotating key signs every visitor out on each restart.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-something-random

# development | production | testing
APP_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave everything below unset and the app uses SQLite at
# backend/instance/taskforge.db — no database server needed to run locally.
#
# DATABASE_URL wins over the DB_* variables when both are set. The legacy
# `postgres://` scheme that Render and Railway hand out is normalised
# automatically, so their value can be pasted in verbatim.
#
# Postgres: DATABASE_URL=postgresql://user:password@host:5432/taskforge
#   Local:  `docker compose up -d db` (repo root), then
#           DATABASE_URL=postgresql://taskforge:taskforge@localhost:5432/taskforge
#   Hosted (Neon, Supabase, Railway, Render): paste their URL as-is; keep any
#           `?sslmode=require` on the end.
# MySQL:    DATABASE_URL=mysql://user:password@localhost:3306/taskforge
# SQLite:   DATABASE_URL=sqlite:///taskforge.db

# Or configure MySQL piecewise instead of a full URL:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=taskforge

# ---------------------------------------------------------------------------
# First-boot bootstrap
# ---------------------------------------------------------------------------
# On an empty database the app creates the default departments and one admin.
# Leave the password unset and a random one is generated and logged once.
BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# AUTO_BOOTSTRAP=1

# ---------------------------------------------------------------------------
# Auth policy (defaults shown)
# ---------------------------------------------------------------------------
# MIN_PASSWORD_LENGTH=8
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# Admin console sessions end after this much inactivity.
# ADMIN_IDLE_MINUTES=30
# SESSION_LIFETIME_SECONDS=43200

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# WEB_CONCURRENCY=2
# LOG_LEVEL=info
