# Copy this file to backend/.env and fill in your local MySQL credentials.

SECRET_KEY=change-this-to-something-random
FLASK_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taskforge

# Or skip the DB_* vars above entirely and set one full connection string:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/taskforge?charset=utf8mb4
